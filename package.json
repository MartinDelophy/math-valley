{
  "name": "math-valley",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop:install": "npm --prefix desktop ci",
    "desktop:start": "npm run build && npm --prefix desktop start",
    "desktop:pack": "npm run build && npm --prefix desktop run pack",
    "desktop:mac": "npm run build && npm --prefix desktop run dist:mac",
    "desktop:win": "npm run build && npm --prefix desktop run dist:win",
    "test:desktop": "npm --prefix desktop test"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.186.1",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.7"
  }
}
